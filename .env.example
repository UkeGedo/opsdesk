NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/opsdesk.db
ATTACHMENT_DIR=./data/attachments
ATTACHMENT_MAX_BYTES=5242880
APP_ORIGIN=http://127.0.0.1:5173
# En desarrollo, file guarda correos de prueba en apps/api/data/mail.
MAIL_MODE=file
MAIL_DIR=./data/mail
# Para producción configurar MAIL_MODE=smtp, APP_ORIGIN HTTPS y un proveedor SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
